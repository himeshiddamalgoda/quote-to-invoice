generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SALES
  MANAGER
  FINANCE
  VIEWER
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT_TO_CUSTOMER
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  EXPIRED
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum ProformaStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum AuditAction {
  QUOTATION_CREATED
  QUOTATION_UPDATED
  QUOTATION_SUBMITTED
  QUOTATION_APPROVED
  QUOTATION_REJECTED
  QUOTATION_REOPENED
  QUOTATION_SENT
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  QUOTATION_EXPIRED
  PROFORMA_CREATED
  PROFORMA_ISSUED
  PROFORMA_CANCELLED
}

enum DocumentKind {
  QT
  PI
}

model User {
  id           String              @id @default(uuid()) @db.Char(36)
  email        String              @unique @db.VarChar(254)
  name         String              @db.VarChar(120)
  passwordHash String
  role         Role                @default(VIEWER)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  quotations   Quotation[]
  approvals    QuotationApproval[]
  proformas    ProformaInvoice[]
  auditLogs    AuditLog[]
}

model Customer {
  id             String            @id @default(uuid()) @db.Char(36)
  name           String            @db.VarChar(200)
  email          String?           @db.VarChar(254)
  phone          String?           @db.VarChar(40)
  billingAddress String?           @db.Text
  taxIdentifier  String?           @db.VarChar(80)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  quotations     Quotation[]
  proformas      ProformaInvoice[]

  @@index([name])
}

model Product {
  id             String                @id @default(uuid()) @db.Char(36)
  sku            String                @unique @db.VarChar(80)
  name           String                @db.VarChar(200)
  description    String?               @db.Text
  unit           String                @db.VarChar(30)
  currency       String                @db.Char(3)
  unitPrice      Decimal               @db.Decimal(19, 4)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  quotationItems QuotationItem[]
  proformaItems  ProformaInvoiceItem[]
}

model Quotation {
  id                 String              @id @default(uuid()) @db.Char(36)
  number             String              @unique @db.VarChar(40)
  customerId         String              @db.Char(36)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Commercial snapshots prevent subsequent customer changes altering issued documents.
  customerName       String              @db.VarChar(200)
  customerEmail      String?             @db.VarChar(254)
  billingAddress     String?             @db.Text
  taxIdentifier      String?             @db.VarChar(80)
  quotationDate      DateTime            @db.Date
  validUntil         DateTime            @db.Date
  currency           String              @db.Char(3)
  subtotal           Decimal             @db.Decimal(19, 2)
  discountAmount     Decimal             @default(0) @db.Decimal(19, 2)
  taxRate            Decimal             @default(0) @db.Decimal(7, 4)
  taxAmount          Decimal             @db.Decimal(19, 2)
  total              Decimal             @db.Decimal(19, 2)
  paymentTerms       String?             @db.Text
  notes              String?             @db.Text
  termsAndConditions String?             @db.Text
  status             QuotationStatus     @default(DRAFT)
  version            Int                 @default(1)
  createdById        String              @db.Char(36)
  createdBy          User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              QuotationItem[]
  approvals          QuotationApproval[]
  proforma           ProformaInvoice?

  @@index([customerId, createdAt])
  @@index([status, validUntil])
  @@index([createdById, createdAt])
}

model QuotationItem {
  id             String    @id @default(uuid()) @db.Char(36)
  quotationId    String    @db.Char(36)
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String?   @db.Char(36)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: Restrict)
  position       Int
  description    String    @db.Text
  unit           String    @db.VarChar(30)
  quantity       Decimal   @db.Decimal(15, 4)
  unitPrice      Decimal   @db.Decimal(19, 4)
  discountAmount Decimal   @default(0) @db.Decimal(19, 2)
  lineTotal      Decimal   @db.Decimal(19, 2)

  @@unique([quotationId, position])
  @@index([productId])
}

model QuotationApproval {
  id               String         @id @default(uuid()) @db.Char(36)
  quotationId      String         @db.Char(36)
  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  approverId       String         @db.Char(36)
  approver         User           @relation(fields: [approverId], references: [id], onDelete: Restrict)
  quotationVersion Int
  action           ApprovalAction
  comment          String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([quotationId, createdAt])
  @@index([approverId])
}

model ProformaInvoice {
  id                     String                @id @default(uuid()) @db.Char(36)
  number                 String                @unique @db.VarChar(40)
  // One PI per source quotation; cancellation does not release this constraint.
  sourceQuotationId      String                @unique @db.Char(36)
  sourceQuotation        Quotation             @relation(fields: [sourceQuotationId], references: [id], onDelete: Restrict)
  sourceQuotationVersion Int
  customerId             String                @db.Char(36)
  customer               Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName           String                @db.VarChar(200)
  customerEmail          String?               @db.VarChar(254)
  billingAddress         String?               @db.Text
  taxIdentifier          String?               @db.VarChar(80)
  invoiceDate            DateTime              @db.Date
  currency               String                @db.Char(3)
  subtotal               Decimal               @db.Decimal(19, 2)
  discountAmount         Decimal               @db.Decimal(19, 2)
  taxRate                Decimal               @db.Decimal(7, 4)
  taxAmount              Decimal               @db.Decimal(19, 2)
  total                  Decimal               @db.Decimal(19, 2)
  paymentTerms           String?               @db.Text
  notes                  String?               @db.Text
  termsAndConditions     String?               @db.Text
  status                 ProformaStatus        @default(DRAFT)
  issuedAt               DateTime?
  cancelledAt            DateTime?
  createdById            String                @db.Char(36)
  createdBy              User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  items                  ProformaInvoiceItem[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([createdById])
}

model ProformaInvoiceItem {
  id                String          @id @default(uuid()) @db.Char(36)
  proformaInvoiceId String          @db.Char(36)
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  productId         String?         @db.Char(36)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  position          Int
  description       String          @db.Text
  unit              String          @db.VarChar(30)
  quantity          Decimal         @db.Decimal(15, 4)
  unitPrice         Decimal         @db.Decimal(19, 4)
  discountAmount    Decimal         @db.Decimal(19, 2)
  lineTotal         Decimal         @db.Decimal(19, 2)

  @@unique([proformaInvoiceId, position])
  @@index([productId])
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Char(36)
  actorId   String?     @db.Char(36)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String      @db.VarChar(60)
  entityId  String      @db.Char(36)
  // Only allowlisted, non-sensitive metadata belongs here.
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

model DocumentSequence {
  kind  DocumentKind
  year  Int
  value Int          @default(0)

  @@id([kind, year])
}
